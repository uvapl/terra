{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": true,
    "allowJs": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true
  },
  "include": [
    "static/js/**/*.js",
    "static/plugins/**/*.js",
    "static/js/vendor/jquery/jquery.d.ts",
    "static/vendor/golden-layout/2.6.0/golden-layout.esm.d.ts"
  ],
  "exclude": [
    "static/js/vendor/**/*.js",
    "static/vendor/**/*.js",
    "static/wasm/**",
    "node_modules"
  ]
}
